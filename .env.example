# CyberShield Environment Variables Example
# Copy this file to .env to configure local settings.
# Do NOT commit .env with real credentials into version control.

# Optional: abuse.ch URLhaus Personal Auth-Key
# abuse.ch requires a free Auth-Key to access official URLhaus exports.
# You can obtain a free community key at: https://auth.abuse.ch/
#
# If URLHAUS_AUTH_KEY is not configured, CyberShield automatically uses
# the live TweetFeed infosec community telemetry feed out-of-the-box,
# so the threat intelligence module is 100% functional without any key.
URLHAUS_AUTH_KEY=your_urlhaus_auth_key_here

# Dev Server Port (default: 5173)
PORT=5173
