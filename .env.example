# CyberShield Environment Variables Example
# Copy this file to .env to configure local settings.
# Do NOT commit .env with real credentials into version control.

# Optional: URLhaus Auth-Key (from https://urlhaus.abuse.ch/api/)
# The public CSV feed (/downloads/csv_recent/) works without an API key.
# An Auth-Key is only required if querying the restricted v1 JSON API.
URLHAUS_AUTH_KEY=your_urlhaus_auth_key_here

# Dev Server Port (default: 5173)
PORT=5173
